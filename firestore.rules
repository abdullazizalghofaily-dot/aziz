rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isApprovedChef() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/chefs/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/chefs/$(request.auth.uid)).data.status == 'approved';
    }
    function isMenuEditor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/menuEditors/$(request.auth.uid));
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isApprovedChef() && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isApprovedChef() && resource.data.createdBy == request.auth.uid);
    }

    match /chefs/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isApprovedChef();
    }

    match /menu/{mealId} {
      allow read: if true;
      allow write: if isAdmin() || isMenuEditor();
    }

    match /menuEditors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
